# Configuração exclusiva da STOA. Nunca copiar credenciais de outro negócio.
NEXT_PUBLIC_SITE_URL=https://stoa-management.ch
# 0: pré-visualização sem indexação; 1: publicação. Definir antes do build.
STOA_PUBLICATION=0
# Conta Resend própria e remetente num domínio verificado.
RESEND_API_KEY=
CONTACT_FROM=
# Confirmar o destinatário com a STOA antes de configurar.
CONTACT_TO=
# Recomendado para contadores partilhados em alojamento serverless.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
